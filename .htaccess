Options -Indexes

# Block access to .git directory and all its contents
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.git(/.*)?$ - [F,L]
</IfModule>

# Block sensitive files
<FilesMatch "\.(sql|md|txt|gitignore|env)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
